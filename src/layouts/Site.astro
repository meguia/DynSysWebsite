---
import '../styles/site.css';
import 'katex/dist/katex.min.css';

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? 'DynSys';
const description = frontmatter?.description ?? Astro.props.description ??
  'Model equations, numerical implementations and recordings.';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2c1428" />
    <title>{title} · DynSys</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="site-name" href={base} aria-label="DynSys home">DynSys</a>
      <nav aria-label="Main navigation">
        <a href={`${base}models/`} aria-current={(path === base || path.startsWith(`${base}models/`)) ? 'page' : undefined}>Models</a>
        <a href={`${base}recordings/`} aria-current={path.startsWith(`${base}recordings/`) ? 'page' : undefined}>Recordings</a>
        <a href={`${base}start/`} aria-current={path === `${base}start/` ? 'page' : undefined}>Implementation</a>
      </nav>
    </header>
    <main id="main" class="wrap">
      {frontmatter ? (
        <article class="prose">
          <h1>{title}</h1>
          <slot />
        </article>
      ) : <slot />}
    </main>
    <footer class="site-footer wrap">
      <span>© 2026 Manuel Eguia</span>
      <span>Software: <a href={`${base}licenses/software.txt`} rel="license">PolyForm Noncommercial</a></span>
      <span>Recordings: <a href={`${base}media/LICENSE.txt`} rel="license">CC BY 4.0</a></span>
    </footer>
  </body>
</html>
