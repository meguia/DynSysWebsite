---
import '../styles/site.css';
import 'katex/dist/katex.min.css';

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? 'DynSys';
const description = frontmatter?.description ?? Astro.props.description ??
  'Model equations, numerical implementations and recordings.';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2c1428" />
    <title>{title} · DynSys</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="site-name" href="/" aria-label="DynSys home">DynSys</a>
      <nav aria-label="Main navigation">
        <a href="/models/" aria-current={(path === '/' || path.startsWith('/models/')) ? 'page' : undefined}>Models</a>
        <a href="/recordings/" aria-current={path.startsWith('/recordings/') ? 'page' : undefined}>Recordings</a>
        <a href="/start/" aria-current={path === '/start/' ? 'page' : undefined}>Implementation</a>
      </nav>
    </header>
    <main id="main" class="wrap">
      {frontmatter ? (
        <article class="prose">
          <h1>{title}</h1>
          <slot />
        </article>
      ) : <slot />}
    </main>
  </body>
</html>
