---
import Site from '../layouts/Site.astro';
---
<Site>
  <h1>RealTimeAudioVisualDynamics</h1>
  <section aria-labelledby="models-title">
    <h2 id="models-title">Models</h2>
    <table>
      <thead><tr><th scope="col">Collection</th><th scope="col">Formulation</th></tr></thead>
      <tbody>
        <tr><td><a href="/models/oscillators/">Oscillators</a></td><td>ODEs and a scalar retarded DDE</td></tr>
        <tr><td><a href="/models/chaos/">Chaos</a></td><td>ODEs and a scalar retarded DDE</td></tr>
        <tr><td><a href="/models/tubes/">Tubes</a></td><td>Neutral DDEs and modal ODE approximations</td></tr>
        <tr><td><a href="/models/saxophone/">Saxophone</a></td><td>Reed–resonator ODEs with fingering-dependent impedance</td></tr>
      </tbody>
    </table>
  </section>
  <section id="recordings" aria-labelledby="recordings-title">
    <h2 id="recordings-title">Recordings</h2>
    <figure>
      <video controls playsinline preload="none" width="1920" height="1080"
        poster="/media/openwind-saxophone-scale.jpg" aria-label="OpenWind saxophone scale"
        aria-describedby="recording-caption">
        <source src="/media/openwind-saxophone-scale.mp4" type="video/mp4" />
        <p><a href="/media/openwind-saxophone-scale.mp4">OpenWind saxophone scale (MP4)</a></p>
      </video>
      <figcaption id="recording-caption">
        Fig. 1. <a href="/models/saxophone/">OpenWind saxophone</a>: scale, Vulkan interface. <time datetime="2026-11-15">15 November 2026</time>; 53.38 s; stereo. <a href="/media/openwind-saxophone-scale.mp4" download>MP4</a>
      </figcaption>
    </figure>
  </section>
</Site>
