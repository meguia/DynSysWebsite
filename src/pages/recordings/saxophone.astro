---
import Site from '../../layouts/Site.astro';

const media = `${import.meta.env.BASE_URL}media/`;
const recordings = [
  { slug: 'openwind-saxophone-scale', title: 'OpenWind scale', duration: '53.38' },
  { slug: 'measured-fingering-tremolos', title: 'Measured fingering tremolos', duration: '81.88' },
];
---
<Site title="Saxophone" description="Saxophone recordings.">
  <h1>Saxophone</h1>
  {recordings.map(({ slug, title, duration }) => (
    <figure id={slug}>
      <video controls playsinline preload="none" width="1920" height="1080"
        poster={`${media}${slug}.jpg`} aria-label={title}
        aria-describedby={`${slug}-caption`}>
        <source src={`${media}${slug}.mp4`} type="video/mp4" />
        <p><a href={`${media}${slug}.mp4`}>{title} (MP4)</a></p>
      </video>
      <figcaption id={`${slug}-caption`}>
        <strong>{title}</strong>. <time datetime="2026-11-15">15 November 2026</time>; {duration} s; stereo. <a href={`${media}${slug}.mp4`} download>MP4</a>
      </figcaption>
    </figure>
  ))}
</Site>
